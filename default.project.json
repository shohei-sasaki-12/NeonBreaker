{
  "name": "NeonBreaker",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Remotes": {
        "$className": "Folder",
        "Progression": {
          "$className": "Folder",
          "LevelUpAvailable": { "$className": "RemoteEvent" },
          "SelectUpgrade": { "$className": "RemoteEvent" }
        },
        "Combat": {
          "$className": "Folder",
          "FireWeapon": {
            "$className": "RemoteEvent"
          },
          "ReloadWeapon": {
            "$className": "RemoteEvent"
          },
          "WeaponStateChanged": {
            "$className": "RemoteEvent"
          }
        }
      },
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$className": "Folder"
      }
    },

    "ServerStorage": {
      "EnemyModels": {
        "$path": "src/serverStorage/EnemyModels"
      }
    },

    "ServerScriptService": {
      "$path": "src/server"
    },

    "StarterGui": {
      "LevelUpUI": {
        "$className": "ScreenGui",
        "$properties": {
          "Enabled": false,
          "ResetOnSpawn": false,
          "DisplayOrder": 20,
          "ZIndexBehavior": "Sibling"
        }
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/client"
      }
    },

    "Workspace": {
      "ExperienceOrbs": {
        "$className": "Folder"
      },
      "EnemyContainer": {
        "$className": "Folder"
      },
      "ProjectileContainer": {
        "$className": "Folder"
      },
      "EffectContainer": {
        "$className": "Folder"
      },
      "SpawnPoints": {
        "$className": "Folder"
      },
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
